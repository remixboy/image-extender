{
  "name": "image-extender-desktop",
  "productName": "Image Extender",
  "version": "1.0.0",
  "description": "Desktop app wrapper for Image Extender",
  "author": "thegarvanator",
  "license": "MIT",
  "private": true,
  "main": "electron-main.js",
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.thegarvanator.imageextender",
    "productName": "Image Extender",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron-main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../.next/standalone",
        "to": "next-server",
        "filter": ["**/*"]
      },
      {
        "from": "../.next/static",
        "to": "next-server/.next/static",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Image-Extender-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Image-Extender-Portable-${version}.${ext}"
    },
    "mac": {
      "category": "public.app-category.graphics-design",
      "identity": null,
      "target": ["dir"]
    }
  }
}
